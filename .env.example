# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# LLM Providers (configure at least one)
# --- FREE tiers (no credit card required) ---
NVIDIA_API_KEY=
GLM_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=
GEMINI_API_KEY_FREE=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- FREE-PREMIUM tiers (free tier on paid-quality providers) ---
CEREBRAS_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=

# --- Paid tiers (real cheap) ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Paid tiers (cheapest to most expensive) ---
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OmniParser — configure at least one provider
# Priority 1: Hugging Face Gradio (Microsoft's official deployment, no cold starts)
HUGGINGFACE_OMNIPARSER_ENDPOINT=

# Priority 2: Modal.com serverless GPU
MODAL_API_KEY=
MODAL_OMNIPARSER_ENDPOINT=

# Priority 3: Replicate (fallback, has cold starts)
REPLICATE_API_TOKEN=

# OmniParser warmup — keeps Replicate model hot (only needed for Replicate)
OMNIPARSER_WARMUP_ENABLED=true

# Redis — optional, enables OmniParser result caching
REDIS_HOST=
REDIS_PORT=6379
